{
  "name": "mega-maps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-check --fail-on-warnings && vite build && node scripts/build-sw.mjs",
    "build:dev": "svelte-check --fail-on-warnings && vite build --mode dev && node scripts/build-sw.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --conditions=browser --import ./tests/setup.ts --test tests/*.test.ts",
    "bench": "tsx bench/run.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.7.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide": "1.55.0",
    "onnxruntime-web": "^1.30.0"
  }
}
